{
  "name": "kaunas-transfer-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "test:domain": "node --experimental-strip-types --test tests/booking.test.ts",
    "test:maps": "node --experimental-strip-types --test tests/maps.test.ts",
    "test:quote": "node --experimental-strip-types --test tests/quote.test.ts",
    "test:schedule": "node --experimental-strip-types --test tests/schedule.test.ts",
    "test:checkout": "node --experimental-strip-types --test tests/checkout-data.test.ts tests/checkout-event.test.ts && node --experimental-strip-types --experimental-test-module-mocks --test tests/orders.test.ts",
    "test:email": "node --experimental-strip-types --test tests/booking-email.test.ts && node --experimental-strip-types --experimental-test-module-mocks --test tests/booking-notifications.test.ts tests/stripe-webhook-email.test.ts tests/retry-booking-emails.test.ts",
    "test": "npm run test:domain && npm run test:maps && npm run test:quote && npm run test:schedule && npm run test:checkout && npm run test:email",
    "preview": "vite preview"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@stripe/stripe-js": "^7.9.0",
    "@vercel/functions": "^3.9.9",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/google.maps": "^3.66.3",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vercel/node": "^5.3.13",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
